# Copy this file to `.env` and fill in your key. `.env` is gitignored.

# --- Groq (primary provider, OpenAI-compatible API) ---
GROQ_API_KEY=your_groq_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Primary extraction model and the faster model used for prompt comparison.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

# --- Offline fallback (Ollama). Only used if PROVIDER=ollama ---
PROVIDER=groq
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# --- CORS: the frontend dev origin ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Pipeline behaviour ---
MAX_REPAIR_RETRIES=2
ENABLE_ICD10=true
# ICD-10 backend: "mcp" spawns the icd10_mcp server; "function" uses in-process
# function calling. "mcp" falls back to "function" automatically if the server
# fails to start.
ICD10_MODE=mcp
# Cache LLM responses on disk so run_eval.py --from-cache regenerates offline.
ENABLE_CACHE=true
