# Copy to .env and edit. A real LLM is REQUIRED (there is no offline provider):
# set a provider, model and base URL below (see the Groq example).

# --- LLM (SPEC.md §8) ---
# openai_compat only (hosted OpenAI-compatible chat API, e.g. Groq GPT-OSS)
MEDEXTRACT_LLM_PROVIDER=openai_compat
MEDEXTRACT_MODEL=openai/gpt-oss-20b
MEDEXTRACT_LLM_BASE_URL=https://api.groq.com/openai/v1
MEDEXTRACT_LLM_API_KEY=
MEDEXTRACT_LLM_TIMEOUT=30

# --- Groq (GPT-OSS) example: uncomment these four to use it ---
# Groq exposes an OpenAI-compatible API, so use the openai_compat provider.
# Get a key at https://console.groq.com/keys
# MEDEXTRACT_LLM_PROVIDER=openai_compat
# MEDEXTRACT_MODEL=openai/gpt-oss-20b          # or openai/gpt-oss-120b
# MEDEXTRACT_LLM_BASE_URL=https://api.groq.com/openai/v1
# MEDEXTRACT_LLM_API_KEY=gsk_your_key_here

# --- Prompts / pipeline ---
MEDEXTRACT_PROMPT_VERSION=v1
MAX_REPAIR_ATTEMPTS=2
FUZZY_GROUNDING_THRESHOLD=90

# --- ICD-10 agent ---
MAX_ICD10_TOOL_CALLS_PER_TERM=5
MAX_ICD10_TOOL_CALLS_PER_NOTE=25
ICD10_CONFIDENCE_THRESHOLD=0.6
ICD10_ACCEPT_THRESHOLD=0.8
# ICD-10 coding is ONLINE-ONLY (live NLM lookup, needs internet). There is no
# local backend or offline fallback: if NLM is unreachable the agent abstains.
ICD10_BACKEND=nlm

# --- Safety / privacy / security ---
MEDEXTRACT_MAX_NOTE_BYTES=50000
MEDEXTRACT_API_KEY=
MEDEXTRACT_ALLOWED_ORIGINS=*
MEDEXTRACT_REDACT_INPUT=false
LOG_LEVEL=INFO
